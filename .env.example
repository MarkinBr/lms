# ============================================================
# CETSADP LMS v9.3.5 — Variáveis de Ambiente
# Copie para .env e configure antes do deploy
# ============================================================

APP_NAME=CETSADP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cetsadp.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ============ BANCO DE DADOS (PostgreSQL) ============
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cetsadp_lms
DB_USERNAME=cetsadp_user
DB_PASSWORD=TROQUE_AQUI_SENHA_FORTE

# ============ SESSÃO E CACHE ============
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ============ REDIS ============
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=TROQUE_AQUI_SENHA_REDIS
REDIS_PORT=6379

# ============ E-MAIL ============
# O config/mail.php lê MAIL_SCHEME (não MAIL_ENCRYPTION).
# Para SMTP na porta 587 (STARTTLS), use MAIL_SCHEME=smtp.
# Resend é usado via SMTP (o SDK resend/resend-php não está instalado),
# portanto mantenha MAIL_MAILER=smtp.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contato@cetsadp.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Remetente e Reply-To específicos das confirmações de inscrição (Issue #39).
# Sem credenciais reais aqui: preencha senha/token somente no .env local.
MAIL_INSCRICOES_FROM_ADDRESS="inscricoes@cetsadp.com.br"
MAIL_INSCRICOES_FROM_NAME="CETSADP"
MAIL_INSCRICOES_REPLY_TO_ADDRESS="contato@cetsadp.com.br"
MAIL_INSCRICOES_REPLY_TO_NAME="Secretaria CETSADP"
MAIL_CONTACT_TO_ADDRESS="contato@cetsadp.com.br"
MAIL_CONTACT_TO_NAME="Secretaria CETSADP"
MAIL_CONTACT_FROM_ADDRESS="contato@cetsadp.com.br"
MAIL_CONTACT_FROM_NAME="CETSADP"

# ============ MERCADO PAGO (Pagamentos) ============
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_URL=https://cetsadp.com.br/api/webhook/mercadopago

# ============ AWS (Opcional - Storage) ============
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============ DOCUMENTOS DE INSCRIÇÃO (Issue #50) ============
# Disco PRIVADO onde RG, CPF, comprovantes e histórico são armazenados.
# NUNCA use "public" nem aponte para storage/app/public.
APPLICATIONS_DISK=applications
APPLICATIONS_DRIVER=local

# Preencha somente se APPLICATIONS_DRIVER=s3 (S3 / Cloudflare R2).
# Sem credenciais reais aqui: defina valores somente no .env local.
APPLICATIONS_S3_KEY=
APPLICATIONS_S3_SECRET=
APPLICATIONS_S3_REGION=
APPLICATIONS_S3_BUCKET=
APPLICATIONS_S3_ENDPOINT=
APPLICATIONS_S3_PATH_STYLE=false

# ============ SSO CETSADP LIVE ============
# ⚠️ GERE COM: openssl rand -hex 32 (mínimo 64 caracteres)
# ⚠️ DEVE SER IDÊNTICO ao SSO_SHARED_SECRET do .env principal (backend Node.js)
CETSADP_LIVE_API_URL=http://backend:3000
CETSADP_SSO_SECRET=GERE-COM-openssl-rand-hex-32-MINIMO-64-CHARS
SSO_TOKEN_EXPIRY_MINUTES=5

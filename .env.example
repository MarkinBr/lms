# ============================================================
# CETSADP LMS v9.3.5 — Variáveis de Ambiente
# Copie para .env e configure antes do deploy
# ============================================================

APP_NAME=CETSADP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cetsadp.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ============ BANCO DE DADOS (PostgreSQL) ============
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cetsadp_lms
DB_USERNAME=cetsadp_user
DB_PASSWORD=TROQUE_AQUI_SENHA_FORTE

# ============ SESSÃO E CACHE ============
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ============ REDIS ============
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=TROQUE_AQUI_SENHA_REDIS
REDIS_PORT=6379

# ============ E-MAIL ============
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="contato@cetsadp.com.br"
MAIL_FROM_NAME="CETSADP"
MAIL_CONTACT_DESTINATION="contato@cetsadp.com.br"
MAIL_CONTACT_FROM_ADDRESS="contato@cetsadp.com.br"
MAIL_CONTACT_FROM_NAME="CETSADP"

# ============ MERCADO PAGO (Pagamentos) ============
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_URL=https://cetsadp.com.br/api/webhook/mercadopago

# ============ AWS (Opcional - Storage) ============
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============ SSO CETSADP LIVE ============
# ⚠️ GERE COM: openssl rand -hex 32 (mínimo 64 caracteres)
# ⚠️ DEVE SER IDÊNTICO ao SSO_SHARED_SECRET do .env principal (backend Node.js)
CETSADP_LIVE_API_URL=http://backend:3000
CETSADP_SSO_SECRET=GERE-COM-openssl-rand-hex-32-MINIMO-64-CHARS
SSO_TOKEN_EXPIRY_MINUTES=5

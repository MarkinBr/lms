<?php

namespace App\Http\Controllers;

use App\Models\Mensalidade;
use App\Models\TransacaoTeste; // <--- IMPORTANTE: Adicione o Model de Teste
use App\Services\MercadoPagoService;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Log;

class WebhookController extends Controller
{
    /**
     * Recebe notificações do Mercado Pago
     */
    public function mercadoPago(Request $request)
    {
        try {
            // O MP envia diferentes tipos de notificações
            $tipo = $request->input('type') ?? $request->input('topic');
            $dataId = $request->input('data.id') ?? $request->input('id');

            if ($tipo !== 'payment' || !$dataId) {
                return response()->json(['status' => 'ignored'], 200);
            }

            Log::info("Webhook MP recebido para Pagamento ID: {$dataId}");

            // Instancia o Service para consultar a API
            $mpService = new MercadoPagoService();
            $dadosPagamento = $mpService->consultarPagamento($dataId);

            if (!$dadosPagamento) {
                Log::warning('Pagamento não encontrado na API do MP', ['id' => $dataId]);
                return response()->json(['status' => 'not_found_in_api'], 404);
            }

            $statusMP = $dadosPagamento['status'] ?? null;

            // ========================================================
            // 1. TENTA ACHAR NA TABELA REAL (PRIORIDADE)
            // ========================================================
            $mensalidade = Mensalidade::where('transacao_id', $dataId)->first();

            if ($mensalidade) {
                // Lógica de Atualização da Mensalidade Real
                $novoStatus = match($statusMP) {
                    'approved' => 'Pago',
                    'pending', 'in_process', 'in_mediation' => 'Pendente',
                    'rejected', 'cancelled', 'refunded', 'charged_back' => 'Cancelado',
                    default => $mensalidade->status
                };

                $dadosAtualizacao = ['status' => $novoStatus];

                if ($statusMP === 'approved' && !$mensalidade->data_pagamento) {
                    $dadosAtualizacao['data_pagamento'] = now();
                    $dadosAtualizacao['observacao'] = 'Pagamento confirmado via webhook';
                }

                $mensalidade->update($dadosAtualizacao);

                Log::info('Mensalidade REAL atualizada via webhook', [
                    'id' => $mensalidade->id,
                    'novo_status' => $novoStatus
                ]);

                return response()->json(['status' => 'success_mensalidade'], 200);
            }

            // ========================================================
            // 2. SE NÃO ACHOU, TENTA NA TABELA DE TESTES (FALLBACK)
            // ========================================================
            $teste = TransacaoTeste::where('transacao_id', $dataId)->first();

            if ($teste) {
                $teste->update([
                    'status' => $statusMP,
                    'payload_completo' => $dadosPagamento
                ]);

                Log::info('Transação de TESTE atualizada via webhook', [
                    'id' => $teste->id,
                    'novo_status' => $statusMP
                ]);

                return response()->json(['status' => 'success_teste'], 200);
            }

            // ========================================================
            // 3. NÃO ENCONTROU EM LUGAR NENHUM
            // ========================================================
            Log::warning('Transação não encontrada em Mensalidades nem Testes', ['id' => $dataId]);
            
            // Retorna 200 para o MP parar de tentar enviar (já que o ID não existe no nosso banco)
            return response()->json(['status' => 'not_found_local'], 200);

        } catch (\Throwable $e) {
            Log::error('Erro Fatal Webhook MP', [
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString()
            ]);

            return response()->json(['status' => 'error', 'message' => $e->getMessage()], 500);
        }
    }

    public function test(Request $request)
    {
        Log::info('Teste de rota webhook', $request->all());
        return response()->json(['status' => 'ok', 'time' => now()]);
    }
}
<?php

namespace App\Services;

use App\Models\Mensalidade;
use Exception;
use Illuminate\Support\Facades\Log;

// Imports da Versão Nova (V3)
use MercadoPago\MercadoPagoConfig;
use MercadoPago\Client\Payment\PaymentClient;
use MercadoPago\Client\Common\RequestOptions;
use MercadoPago\Exceptions\MPApiException;

class MercadoPagoService
{
    public function __construct()
    {
        $token = config('services.mercadopago.token');

        if (!$token) {
            throw new Exception("Token do Mercado Pago não configurado.");
        }

        // Configuração V3
        MercadoPagoConfig::setAccessToken($token);
    }

    /**
     * Gera pagamento PIX
     */
    public function gerarPix(Mensalidade $mensalidade)
    {
        try {
            $client = new PaymentClient();
            
            // Tenta pegar USER (users table) ou ALUNO (tabela legada)
            $pagador = $mensalidade->matricula->user ?? $mensalidade->matricula->aluno;

            if (!$pagador) {
                throw new Exception("Aluno não encontrado na matrícula.");
            }

            // Garante o primeiro nome
            $nomeCompleto = trim($pagador->name ?? $pagador->nome ?? 'Aluno CETS');
            $primeiroNome = explode(' ', $nomeCompleto)[0];

            $request = [
                "transaction_amount" => $this->normalizarValor($mensalidade->valor),
                "description" => "Mensalidade " . $mensalidade->mes_referencia . " - " . $nomeCompleto,
                "payment_method_id" => "pix",
                "payer" => [
                    "email" => $this->validarEmail($pagador->email),
                    "first_name" => $primeiroNome,
                    "identification" => [
                        "type" => "CPF",
                        "number" => $this->limparCPF($pagador->cpf ?? '')
                    ]
                ]
            ];

            $requestOptions = new RequestOptions();
            $requestOptions->setCustomHeaders(["X-Idempotency-Key: " . uniqid('pix_' . $mensalidade->id . '_')]);

            $payment = $client->create($request, $requestOptions);

            if ($payment->id && $payment->status !== 'rejected') {
                $qrCode = $payment->point_of_interaction->transaction_data->qr_code;
                $qrCodeBase64 = $payment->point_of_interaction->transaction_data->qr_code_base64;
                $ticketUrl = $payment->point_of_interaction->transaction_data->ticket_url;

                $mensalidade->update([
                    'transacao_id' => $payment->id,
                    'metodo_pagamento' => 'pix',
                    'pix_copia_cola' => $qrCode,
                    'pix_qr_base64' => $qrCodeBase64,
                    'link_pagamento' => $ticketUrl,
                    'status' => 'Pendente',
                ]);

                return ['success' => true];
            }

            throw new Exception("Pagamento rejeitado/falhou no MP.");

        } catch (MPApiException $e) {
            $content = $e->getApiResponse()->getContent();
            Log::error("Erro MP Pix: ", $content);
            throw new Exception("Erro API MP: " . ($content['message'] ?? 'Erro desconhecido'));
        } catch (\Throwable $e) {
            Log::error("Erro Geral Pix: " . $e->getMessage());
            throw new Exception("Erro interno: " . $e->getMessage());
        }
    }

    /**
     * Gera boleto bancário (CORRIGIDO)
     */
    public function gerarBoleto(Mensalidade $mensalidade)
    {
        try {
            $client = new PaymentClient();
            
            // 1. Definição do Pagador (User ou Aluno)
            $pagador = $mensalidade->matricula->user ?? $mensalidade->matricula->aluno;
            
            if (!$pagador) {
                throw new Exception("Aluno/Usuário não encontrado para esta matrícula.");
            }

            // 2. Separação Inteligente de Nome e Sobrenome
            $nomeCompleto = trim($pagador->name ?? $pagador->nome ?? 'Aluno CETS');
            $partesNome = explode(' ', $nomeCompleto);
            
            $firstName = $partesNome[0];
            
            // Se tiver sobrenome, usa o resto do nome. Se não, usa "Matriculado"
            $lastName = count($partesNome) > 1 
                ? implode(' ', array_slice($partesNome, 1)) 
                : 'Matriculado'; 

            // 3. Validações de Dados Obrigatórios
            $cpf = $this->limparCPF($pagador->cpf ?? '');
            // Se CPF inválido em ambiente de teste, usa um fictício (APENAS PARA EVITAR CRASH, AJUSTE EM PROD)
            if(strlen($cpf) !== 11) $cpf = '19100000000'; 

            $cep = $this->limparCEP($pagador->cep ?? '');
            if(strlen($cep) !== 8) $cep = '01001000'; // CEP Genérico SP

            $request = [
                "transaction_amount" => $this->normalizarValor($mensalidade->valor),
                "description" => "Mensalidade " . ($mensalidade->mes_referencia ?? date('m/Y')),
                "payment_method_id" => "bolbradesco",
                "payer" => [
                    "email" => $this->validarEmail($pagador->email),
                    "first_name" => $firstName,  // CORRIGIDO
                    "last_name" => $lastName,    // CORRIGIDO
                    "identification" => [
                        "type" => "CPF",
                        "number" => $cpf
                    ],
                    "address" => [
                        "zip_code" => $cep,
                        "street_name" => $pagador->endereco ?? 'Rua Padrão',
                        "street_number" => $pagador->numero ?? '100',
                        "neighborhood" => $pagador->bairro ?? 'Bairro',
                        "city" => $pagador->cidade ?? 'Cidade',
                        "federal_unit" => $pagador->estado ?? 'SP'
                    ]
                ]
            ];

            $requestOptions = new RequestOptions();
            $requestOptions->setCustomHeaders(["X-Idempotency-Key: " . uniqid('bol_' . $mensalidade->id . '_')]);

            $payment = $client->create($request, $requestOptions);

            if ($payment->id) {
                $linkBoleto = $payment->transaction_details->external_resource_url 
                              ?? $payment->point_of_interaction->transaction_data->ticket_url;
                              
                $linhaDigitavel = $payment->barcode->content ?? null;

                $mensalidade->update([
                    'transacao_id' => $payment->id,
                    'metodo_pagamento' => 'boleto',
                    'link_boleto' => $linkBoleto,
                    'linha_digitavel' => $linhaDigitavel,
                    'link_pagamento' => $linkBoleto,
                    'status' => 'Pendente',
                ]);

                return ['success' => true, 'link_boleto' => $linkBoleto];
            }

            throw new Exception("Erro ao criar Boleto: ID não retornado.");

        } catch (MPApiException $e) {
            $content = $e->getApiResponse()->getContent();
            Log::error("Erro MP Boleto: ", $content);
            
            // Melhora a mensagem de erro para você ver na tela
            $msg = $content['message'] ?? 'Erro desconhecido';
            if(isset($content['cause'][0])) {
                $msg .= " - " . ($content['cause'][0]['description'] ?? $content['cause'][0]['code']);
            }
            
            throw new Exception("Erro API MP: " . $msg);
        } catch (\Throwable $e) {
            Log::error("Erro Geral Boleto: " . $e->getMessage());
            throw new Exception("Erro interno: " . $e->getMessage());
        }
    }

    /**
     * Consulta status (Usado no Webhook)
     */
    public function consultarPagamento($id)
    {
        try {
            $client = new PaymentClient();
            $payment = $client->get($id);
            return json_decode(json_encode($payment), true); 
        } catch (\Throwable $e) {
            return null;
        }
    }

    /**
     * Atualiza status da mensalidade baseado no webhook
     */
    public function atualizarStatusPagamento(Mensalidade $mensalidade, array $dadosPagamento)
    {
        $status = $dadosPagamento['status'] ?? null;

        $novoStatus = match($status) {
            'approved' => 'Pago',
            'pending', 'in_process' => 'Pendente',
            'rejected', 'cancelled' => 'Cancelado',
            default => $mensalidade->status
        };

        $dados = ['status' => $novoStatus];

        if ($status === 'approved' && !$mensalidade->data_pagamento) {
            $dados['data_pagamento'] = now();
        }

        $mensalidade->update($dados);
        return $mensalidade;
    }

    public function cancelarPagamento(Mensalidade $mensalidade)
    {
        try {
            if (!$mensalidade->transacao_id) {
                throw new Exception("Mensalidade não possui transação associada");
            }
            $client = new PaymentClient();
            $client->cancel($mensalidade->transacao_id);

            $mensalidade->update([
                'status' => 'Cancelado',
                'observacao' => 'Pagamento cancelado manualmente'
            ]);
            return true;
        } catch (\Throwable $e) {
            Log::error("Erro ao cancelar: " . $e->getMessage());
            throw $e;
        }
    }

    // --- Auxiliares ---

    private function normalizarValor($valor): float
    {
        if (is_string($valor)) {
            $valor = str_replace(['.', ','], ['', '.'], $valor);
        }
        return (float) $valor;
    }

    private function validarEmail($email)
    {
        return filter_var($email, FILTER_VALIDATE_EMAIL) ? $email : 'financeiro@cets.com.br';
    }

    private function limparCPF($cpf)
    {
        return preg_replace('/[^0-9]/', '', $cpf ?? '');
    }

    private function limparCEP($cep)
    {
        return preg_replace('/[^0-9]/', '', $cep ?? '');
    }
}
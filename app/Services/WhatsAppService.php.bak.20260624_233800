<?php

namespace App\Services;

use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Log;

class WhatsAppService
{
    private string $apiUrl;
    private string $token;
    private string $instanceId;

    public function __construct()
    {
        // Você pode usar Evolution API, Z-API, Baileys ou qualquer API de WhatsApp
        // Exemplo com Evolution API
        $this->apiUrl = config('services.whatsapp.api_url', 'https://sua-api.com');
        $this->token = config('services.whatsapp.token', '');
        $this->instanceId = config('services.whatsapp.instance_id', '');
    }

    /**
     * Envia mensagem de texto simples
     */
    public function enviarMensagem(string $telefone, string $mensagem): bool
    {
        try {
            $telefone = $this->formatarTelefone($telefone);

            $response = Http::withHeaders([
                'apikey' => $this->token,
                'Content-Type' => 'application/json',
            ])->post("{$this->apiUrl}/message/sendText/{$this->instanceId}", [
                'number' => $telefone,
                'text' => $mensagem,
            ]);

            if ($response->successful()) {
                Log::info('WhatsApp enviado com sucesso', [
                    'telefone' => $telefone,
                    'response' => $response->json()
                ]);
                return true;
            }

            Log::error('Erro ao enviar WhatsApp', [
                'telefone' => $telefone,
                'status' => $response->status(),
                'response' => $response->body()
            ]);

            return false;

        } catch (\Exception $e) {
            Log::error('Exceção ao enviar WhatsApp', [
                'telefone' => $telefone,
                'error' => $e->getMessage()
            ]);
            return false;
        }
    }

    /**
     * Envia imagem com legenda
     */
    public function enviarImagem(string $telefone, string $urlImagem, string $legenda = ''): bool
    {
        try {
            $telefone = $this->formatarTelefone($telefone);

            $response = Http::withHeaders([
                'apikey' => $this->token,
                'Content-Type' => 'application/json',
            ])->post("{$this->apiUrl}/message/sendMedia/{$this->instanceId}", [
                'number' => $telefone,
                'mediatype' => 'image',
                'media' => $urlImagem,
                'caption' => $legenda,
            ]);

            return $response->successful();

        } catch (\Exception $e) {
            Log::error('Erro ao enviar imagem WhatsApp', [
                'telefone' => $telefone,
                'error' => $e->getMessage()
            ]);
            return false;
        }
    }

    /**
     * Envia documento PDF
     */
    public function enviarDocumento(string $telefone, string $urlDocumento, string $nomeArquivo = 'documento.pdf'): bool
    {
        try {
            $telefone = $this->formatarTelefone($telefone);

            $response = Http::withHeaders([
                'apikey' => $this->token,
                'Content-Type' => 'application/json',
            ])->post("{$this->apiUrl}/message/sendMedia/{$this->instanceId}", [
                'number' => $telefone,
                'mediatype' => 'document',
                'media' => $urlDocumento,
                'fileName' => $nomeArquivo,
            ]);

            return $response->successful();

        } catch (\Exception $e) {
            Log::error('Erro ao enviar documento WhatsApp', [
                'telefone' => $telefone,
                'error' => $e->getMessage()
            ]);
            return false;
        }
    }

    /**
     * Envia QR Code do PIX
     */
    public function enviarPixQRCode(string $telefone, string $base64Image, string $copiaECola): bool
    {
        try {
            // Primeiro envia o QR Code
            $this->enviarImagemBase64($telefone, $base64Image, '📱 Escaneie o QR Code para pagar via PIX');
            
            // Depois envia o código copia e cola
            sleep(1); // Pequeno delay entre mensagens
            
            $mensagem = "💰 *PIX Copia e Cola*\n\n";
            $mensagem .= "Cole este código no seu banco:\n\n";
            $mensagem .= "`{$copiaECola}`\n\n";
            $mensagem .= "✅ O pagamento é confirmado automaticamente!";

            return $this->enviarMensagem($telefone, $mensagem);

        } catch (\Exception $e) {
            Log::error('Erro ao enviar PIX WhatsApp', ['error' => $e->getMessage()]);
            return false;
        }
    }

    /**
     * Envia imagem em Base64
     */
    private function enviarImagemBase64(string $telefone, string $base64Image, string $legenda = ''): bool
    {
        try {
            $telefone = $this->formatarTelefone($telefone);

            $response = Http::withHeaders([
                'apikey' => $this->token,
                'Content-Type' => 'application/json',
            ])->post("{$this->apiUrl}/message/sendMedia/{$this->instanceId}", [
                'number' => $telefone,
                'mediatype' => 'image',
                'media' => $base64Image,
                'caption' => $legenda,
            ]);

            return $response->successful();

        } catch (\Exception $e) {
            Log::error('Erro ao enviar imagem base64 WhatsApp', ['error' => $e->getMessage()]);
            return false;
        }
    }

    /**
     * Formata número de telefone para padrão WhatsApp (5521999999999)
     */
    private function formatarTelefone(string $telefone): string
    {
        // Remove tudo que não é número
        $telefone = preg_replace('/[^0-9]/', '', $telefone);

        // Se não tem DDI (55), adiciona
        if (!str_starts_with($telefone, '55')) {
            $telefone = '55' . $telefone;
        }

        // Remove o 9 extra se tiver (ex: 5521999999999 -> 55219999999)
        // Alguns sistemas precisam sem o 9, outros com. Ajuste conforme sua API
        
        return $telefone;
    }

    /**
     * Monta mensagem de lembrete de vencimento
     */
    public function montarMensagemLembrete($mensalidade, int $diasParaVencimento): string
    {
        $aluno = $mensalidade->matricula->user->name;
        $valor = $mensalidade->valor_formatado;
        $vencimento = $mensalidade->data_vencimento->format('d/m/Y');

        if ($diasParaVencimento > 0) {
            $mensagem = "🔔 *Lembrete de Mensalidade*\n\n";
            $mensagem .= "Olá, *{$aluno}*!\n\n";
            $mensagem .= "Sua mensalidade de *{$valor}* vence em *{$diasParaVencimento} dias* ({$vencimento}).\n\n";
            $mensagem .= "Evite multas e juros! Pague antes do vencimento. 😊";
        } else {
            $mensagem = "⚠️ *Mensalidade Vencendo Hoje*\n\n";
            $mensagem .= "Olá, *{$aluno}*!\n\n";
            $mensagem .= "Sua mensalidade de *{$valor}* vence *HOJE* ({$vencimento}).\n\n";
            $mensagem .= "Pague agora para evitar multas!";
        }

        return $mensagem;
    }

    /**
     * Monta mensagem de cobrança (mensalidade atrasada)
     */
    public function montarMensagemCobranca($mensalidade): string
    {
        $aluno = $mensalidade->matricula->user->name;
        $valor = $mensalidade->valor_formatado;
        $valorComMulta = $mensalidade->valor_com_multa_formatado;
        $vencimento = $mensalidade->data_vencimento->format('d/m/Y');
        $diasAtraso = $mensalidade->dias_atraso;

        $mensagem = "🔴 *Mensalidade em Atraso*\n\n";
        $mensagem .= "Olá, *{$aluno}*!\n\n";
        $mensagem .= "Sua mensalidade está atrasada há *{$diasAtraso} dias*.\n\n";
        $mensagem .= "📅 Vencimento: {$vencimento}\n";
        $mensagem .= "💵 Valor original: {$valor}\n";
        $mensagem .= "💰 Valor com multa: *{$valorComMulta}*\n\n";
        $mensagem .= "Por favor, regularize sua situação o quanto antes para não ter problemas com sua matrícula.";

        return $mensagem;
    }

    /**
     * Monta mensagem de confirmação de pagamento
     */
    public function montarMensagemConfirmacaoPagamento($mensalidade): string
    {
        $aluno = $mensalidade->matricula->user->name;
        $valor = $mensalidade->valor_formatado;
        $dataPagamento = $mensalidade->data_pagamento->format('d/m/Y');

        $mensagem = "✅ *Pagamento Confirmado*\n\n";
        $mensagem .= "Olá, *{$aluno}*!\n\n";
        $mensagem .= "Confirmamos o recebimento do seu pagamento de *{$valor}* em {$dataPagamento}.\n\n";
        $mensagem .= "Obrigado por manter sua mensalidade em dia! 🎉\n\n";
        $mensagem .= "Em caso de dúvidas, entre em contato conosco.";

        return $mensagem;
    }
}